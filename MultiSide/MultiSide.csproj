<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Multiside</AssemblyName>
    <RootNamespace>Multiside</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Multiside.shared\Multiside.shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\dependencies\unity\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
    </Reference>
    <Reference Include="MelonLoader">
      <HintPath>..\dependencies\MelonLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\dependencies\Newtonsoft.Json.dll</HintPath>
			<Private>false</Private>
		</Reference>
    <Reference Include="PhotonChat">
      <HintPath>..\dependencies\photon\PhotonChat.dll</HintPath>
		</Reference>
    <Reference Include="PhotonClient">
      <HintPath>..\dependencies\photon\PhotonClient.dll</HintPath>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>..\dependencies\photon\PhotonRealtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\dependencies\unity\UnityEngine.dll</HintPath>
			<Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\dependencies\unity\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>..\dependencies\unity\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>